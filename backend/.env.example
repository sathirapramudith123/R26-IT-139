# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# Auth
JWT_SECRET=your-long-random-secret
JWT_EXPIRES_IN=15min

# ML microservice
ML_URL=http://localhost:8000

# Password reset email (Gmail: turn on 2-Step Verification, then create an App Password)
# If SMTP is not set, in development the reset link is printed to the server console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-project-email@gmail.com
SMTP_PASS=your-gmail-app-password

# Web app URL used to build the reset link
FRONTEND_URL=http://localhost:3000
