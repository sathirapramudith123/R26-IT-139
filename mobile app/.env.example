# Google Maps web-service key (Places, Geocoding, Directions) used by the Dart code.
# Copy this file to .env, put the real key, and run:
#   flutter run --dart-define-from-file=.env
# .env is git-ignored. The Android map key goes in android/local.properties instead:
#   MAPS_API_KEY=your-android-key
GOOGLE_MAPS_API_KEY=your-google-maps-key
